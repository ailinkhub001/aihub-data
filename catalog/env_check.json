    "npmrc": {
      "display_name": "npmrc 优化",
      "homepage": "https://docs.npmjs.com/cli/v10/configuring-npm/npmrc",
      "description": "fund=false：关闭资助提示\naudit=false：跳过安装审计，加速安装\nprogress=false：禁用进度条\nnpm 执行减少日志，减少流程，减少给 AI 的 Token。",
      "kind": "file",
      "category": "system_setting",
      "file": {
        "path": "~/.npmrc",
        "must_exist": true,
        "contains": [
          {
            "line": "fund=false",
            "pattern": "(?m)^\\s*fund\\s*=\\s*false",
            "desc": "关闭资助提示"
          },
          {
            "line": "audit=false",
            "pattern": "(?m)^\\s*audit\\s*=\\s*false",
            "desc": "关闭安装时安全审计，提升安装速度"
          },
          {
            "line": "progress=false",
            "pattern": "(?m)^\\s*progress\\s*=\\s*false",
            "desc": "关闭下载进度条，减少日志噪音"
          }
        ],
        "excludes": []
      },
      "install": [
        {
          "kind": "command",
          "platforms": 7,
          "program": "npm",
          "args": [
            "config",
            "set",
            "fund",
            "false"
          ],
          "requires": [
            "npm"
          ]
        },
